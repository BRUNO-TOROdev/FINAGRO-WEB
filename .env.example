# Variáveis públicas: estes valores são incorporados ao bundle do navegador.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SITE_URL=https://app.example.com

# Segredos de deploy, migration, backup, SMTP e observabilidade são configurados
# somente nos respectivos provedores. Eles nunca usam o prefixo NEXT_PUBLIC_ e
# não são necessários em tempo de execução pela aplicação Next.js atual.
